######### postgres:

# only for production.
OUT_TO_C_DATABASE="database"
OUT_TO_C_DATABASE_USERNAME="user"
OUT_TO_C_DATABASE_URL="postgresql://.."
OUT_TO_C_DATABASE_PASSWORD="secret.."

######### applications:

# create HCA app for this:
HCA_CLIENT_ID="123"
HCA_SECRET="123"

# create a hackatime oauth app for these two:
HACKATIME_UID="123"
HACKATIME_SECRET="123"

# OPTIONAL, IF UNSET WILL USE PUBLIC CACHET API INSTEAD:
# create a slack bot at https://api.slack.com/apps,
# then go to its "OAuth & Permissions",
# and add the scopes listed in the README.md file.
# then install it to hackclub at the top of the page,
# you will then get a token, which you will enter here:
SLACK_BOT_TOKEN="xoxb-..."

# optional:
#DISABLE_SLACK_MESSAGES="1"

######### management:

# optional:
#START_DATE_OVERRIDE = "2026-05-07"

# the slack user to which fulfilment updates are sent,
ADMIN_SLACK_ID="UXXXXXXXXXX"

# comma seperated list of the slack IDs of reviewers
REVIEWERS="UXXXXXXXXX1,UXXXXXXXXX2"
# channel where new ships are notified about.
# the bot needs to be in this channel!
REVIEWER_CHANNEL_ID="CXXXXXXXXXX"


######### airtable & fillout section:

# optional:
#DISABLE_AIRTABLE="1"

# pii is only stored on airrecord, not the local DB.
AIRTABLE_BASE_ID="app..."
AIRTABLE_API_TOKEN="pat..."

# fillout form connected to your airbase table.
# used to collect NPS. do not include the '?id=' part. it is appended automatically
NPS_FILLOUT_URL="https://forms.fillout.com/t/XXXXXXXXXXXX"
