<h1>Admin Panel</h1>

<hr>
<h1>Users:</h1>
<div id="admin-users">
    <% for u in @users %>
        <div class="admin-user-entry">
            <p style="float:right"><%= u.id %></p>
            <p><%= u.name %></p>
            <img src="<%= u.pfp %>">
            <span style="position:absolute;right:5px;bottom:5px;width:fit-content;"><%= u.voyage %></span>
        </div>
    <% end%>
</div>
<hr>
<h1>Voyages:</h1>
<div id="admin-voyages">
    <% for section in @sections %>
        <h2><%= section[0] %>:</h2>
        <div class="admin-voyage-list">
            <% for v in section[1] %>
                <div class="admin-voyage-entry">
                    <a style="float: right" href="edit/<%= v.id %>">edit</a>
                    <p><b><%= v.name %></b></p>
                    <p><%= v.desc %></p>
                    <p><%= v.cargo.blank? ? "<no-cargo>" : v.cargo %></p>
                    <p><%= v.hackatime + " (" + (v.total_seconds / 60 / 60).to_i.to_s + "h)"%></p>
                    <p><a href="<%= v.repo %>"><%= v.repo %></a></p>
                    <span style="position:absolute;right:5px;bottom:5px;width:fit-content;"><%= v.id %></span>
                </div>
            <% end%>
        </div>
    <% end%>
</div>
<hr>