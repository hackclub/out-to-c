<script>
    // load user data for the JS side
    voyage = parseInt('<%= @voyage && @voyage.id %>') || null;
    originalVoyageID = voyage;
    _travelDistance = (parseFloat('<%= @voyage && @voyage.total_seconds %>') / 60.0 / 60.0 || 0.0);

    _activeCameraStateIndex = voyage == null ? 0 : 2;

    prices = "<%= @voyage && @voyage.cargo %>";

    shipStatus = <%= @voyage != nil ? @voyage.ship_status : 0%>
</script>

<style>
    canvas {
        filter: unset !important;
    }
</style>

<div id="background"></div>
<div id="varyingContents" class="hidden">
    <div id="confirmation-container" style="display:none">
        <div id="confirmation-box">
            <p id="confirmation-text" style="margin:0">Are you sure you wish to perform this action?</p>
            <div style="display:flex">
                <button onclick="confirmConfirmation()" class="confirm-btn">Yes, go ahead!</button>
                <button onclick="cancelConfirmation()" class="confirm-btn" style="margin-left:5px">No.</button>
            </div>
        </div>
    </div>
    <%= form_with(url: voyage_delete_path, id: "delete-voyage-form") do |form| end %>

    <button onclick="backVoyage();" id="new-voyage-back"><%= image_tag "graphics/back.png", :alt => "Back" %></button>
    <div id="new-voyage-div" class="page surround-border">
        <style>
            .input-show-on-voyage-create {
                <% if @voyage == nil  %>
                display:none;
                <% end %>
            }
            .input-hide-on-voyage-create {
                <% if @voyage != nil  %>
                display:none;
                <% end %>
            }
        </style>
        <% new_or_edit = @voyage == nil ? "New" : "Edit" %>
        <% create_or_save = @voyage == nil ? "CREATE VOYAGE" : "SAVE CHANGES" %>
        <h1 id="new-voyage-title"><%= new_or_edit %> Voyage</h1>
        <%= form_with(url: voyage_new_path, id: "new-voyage-form", ) do |form| %>
            <label for="image_data" class="input-show-on-voyage-create">
                Screenshot [<span class="info-hover">?<span>The screenshot should showcase your project running.</span></span>]:
                <img src="<%= @voyage != nil && @voyage.image_link != nil ? @voyage.image_link : "" %>" id="image-link-showcase" alt="Project screenshot. Click to edit!">
            </label>
            <%= form.file_field :image_data, accept:"image/*", style:"display:none", onchange:"readURL(this);", autocomplete:"off" %>
            <label for=name>Name: </label><br>
            <input autocomplete="off" name="name" type="text" value="<%= @voyage != nil && @voyage.name != nil ? @voyage.name : "" %>">
            <br>
            <label for=desc>Description<span class="input-hide-on-voyage-create"> (optional)</span>: </label><br>
            <input autocomplete="off" name="desc" type="text"  value="<%= @voyage != nil && @voyage.desc != nil ? @voyage.desc : "" %>">
            <br>
            <div class="input-show-on-voyage-create">
                <label for=repo>Github Repository URL: </label><br>
                <input autocomplete="off" name="repo" type="url"  value="<%= @voyage != nil && @voyage.repo != nil ? @voyage.repo : "" %>">
                <br>
                <label for=demo>Demo URL [<span class="info-hover">?<span>Your project should have a demo experiencable by anyone. Ex: GitHub Releases page or a website where your project is web-playable</span></span>]: </label><br>
                <input autocomplete="off" name="demo" type="url" value="<%= @voyage != nil && @voyage.demo != nil ? @voyage.demo : "" %>">
                <br>
            </div>

            <label for=hackatime>Select Hackatime project<span class="input-hide-on-voyage-create"> (optional)</span>: </label><br>

            <select autocomplete="off" name="hackatime" id="hackatime">
                <option value="" <%= @voyage == nil ? "selected" : "" %>>Select a Hackatime project</option>
                <% @projects.each do |x| %>
                    <% sel = @voyage != nil && @voyage.hackatime == x["name"] ? "selected" : "" %>
                    <option <%= sel %> value="<%= x["name"] %>"><%= x["name"] + " (" + (x["total_seconds"].to_f / 60.0 / 60.0).to_i.to_s + " hrs)" %></option>
                <% end %>
            </select>
            <br>
            
            <button id="new-voyage-form-submit"><%= create_or_save %></button>
            <button id="delete-voyage-button" style="display:<%= @voyage == nil ? "none" : "block" %>" type="button" onclick="tryDeleteVoyage();">Delete Voyage...</button>
        <% end %>
    </div>

    <img id="pfp" src="<%= @user.pfp %>">
    <a href="/docs" target="_blank" id="docs-btn">?</a>
    <div id="cargo-slot-dragging-container"><img id="cargo-slot-dragging"></div>
    <div id="no-existing-voyage" <% if @voyage != nil %> style="display:none;"<% end %>>
        <img id="logo" style="width:450px;" src="<%= asset_path("graphics/logo.svg") %>" alt="Out To C">
        <div id="new-voyage-buttons">
            <div class="surround-border"><a <%= @user.token != nil ? "disabled" : "" %> class="voyage-btn" href="https://hackatime.hackclub.com/oauth/authorize?client_id=<%= ENV["HACKATIME_UID"] %>&redirect_uri=<%= CGI.escape(auth_hackatime_callback_url) %>&response_type=code&scope=read+profile" id="link-hackatime">Link Hackatime</a></div>
            <div class="surround-border"><button <%= @user.token == nil ? "disabled" : "" %> class="voyage-btn" onclick="newVoyage();" id="new-voyage">New Voyage</button></div>
        </div>
    </div>
    <div id="active-voyage" <% if @voyage == nil or @voyage.ship_status != 0 %> style="display:none;"<% end %>>
        <div id="onboarding-container" style="display:none">
            <div id="onboarding-highlight"></div>
            <div id="onboarding-text">
                <p id="onboarding-text-contents">Welcome to Out to C!</p>
                <hr>
                <button id="onboarding-btn" onclick="onboardingNext();" class="light onboarding-btn">Continue</button>
            </div>
        </div>
        <div id="ship-container">
            <button onclick="tryShipVoyage()" id="ship-button">Ship Project</button>
        </div>
        <div id="voyage-info">
            <div id="voyage-info-contents">
                <span class="light">Voyage name:</span>
                <span id="voyage-info-name"><%= @voyage_name_trim %></span><br>
                <span class="light">Desc:</span>
                <span id="voyage-info-desc"><%= @voyage_desc_trim %></span><br>
                <span class="light">Repository URL:</span>
                <a id="voyage-info-repo" style="white-space: nowrap;" href="<%= @voyage != nil && @voyage.repo != nil ? @voyage.repo : "" %>"><%= @voyage_repo_trim %></a><br>
                <span class="light">Hackatime:</span><br>
                <span id="voyage-info-hackatime"> <%= @hackatime_text %> </span><br>
                <button id="edit-voyage" onclick="editVoyage()">Edit Details</button>
            </div>
        </div>
        <div id="openable-map-holder" style="display:none">
            <div onclick="hideMap();" id="map-backdrop"></div>
            <div id="openable-map">
                <%= render "map" %>
            </div>
        </div>
        <div onclick="toggleMap();" id="minimap" <%= @found_island ? "style=display:none" : "" %>>
            <%= image_tag "graphics/ship_icon.png",:id => "ship-icon" , :alt => "ship-icon" %>
            <%= image_tag "graphics/treasure_icon.png",:id => "treasure-icon" , :alt => "treasure-icon" %>
            <% 
            offset = 0
            if @user.seconds_offset != nil
                offset = @user.seconds_offset
            end
            %>
            <span id="minimap-text"><%= @voyage != nil ? (@next_island - (@voyage.total_seconds+offset) / 60 / 60 + 0.5).to_i.to_s : "-" %> hours </span>
        </div>
        <div id="island-found" style="<%= @found_island ? "display:unset; animation-play-state: running;" : "" %>">
            <div id="island-found-center">
                <link rel="preload" as="image" href="<%= image_url("graphics/treasure_chest_open.png")  %>" fetchpriority="high">
                <%= image_tag "graphics/island_found.png",:id => "island-found-image" , :alt => "Island" %>
                <button onclick="selectTreasure()" id="island-found-chest"></button>
            </div>
            <div id="treasure-select-container">
                <div id="treasure-select">
                    <h1>Treasure Chest</h1>
                    <span>Select 1 item to receive.</span>
                    <br>
                    
                    <%= 
                    fp = JSON.parse(@found_prices.to_json)
                    fp.each_with_index do | x, i |
                        x[1]["src"] = image_url("prices/"+x[0].to_s+".png")
                    end

                    ActiveSupport::SafeBuffer.new("<script>found_prices="+fp.to_json+"</script>")
                    %>
                    <div id="prices-buttons">
                    </div>
                    <button id="price-submit-btn" onclick="finalizePriceSelection();" class="confirm-btn">Confirm</button>
                    <%= form_with(url: voyage_price_path, id: "price-form") do |form| end %>
                    </div>
                </div>
        </div>
        <div id="prize-got" style="display:none;">
        </div>
        <div id="ship-pii-container" style="display:none">
            <div id="ship-pii">
                <%= form_with(url: voyage_ship_path, id: "ship-pii-form", ) do |form| %>
                    <span>To ship your project, you'll need to provide some more information.</span>
                    <span>This personal data is stored on a secure, remote database.</span>
                    <br>
                    <br>
                    <% if @user.github_username == nil or @user.github_username.blank? %>
                    <label for=name>GitHub username: </label><br>
                    <input required autocomplete="off" name="github_username" type="text">
                    <br>
                    <% end %>
                    <label for=name>First Name: </label><br>
                    <input required autocomplete="off" name="first_name" type="text">
                    <br>
                    <label for=name>Last Name: </label><br>
                    <input required autocomplete="off" name="last_name" type="text">
                    <br>
                    <label for=name>Birthdate: </label><br>
                    <input required autocomplete="off" name="birthday" type="date">
                    <br>
                    <label for=name>Address (line 1): </label><br>
                    <input required autocomplete="off" name="address_1" type="text">
                    <br>
                    <label for=name>Address (line 2) (optional): </label><br>
                    <input autocomplete="off" name="address_2" type="text">
                    <br>
                    <label for=name>City: </label><br>
                    <input required autocomplete="off" name="city" type="text">
                    <br>
                    <label for=name>State / Province: </label><br>
                    <input required autocomplete="off" name="state" type="text">
                    <br>
                    <label for=name>Country: </label><br>
                    <input required autocomplete="off" name="country" type="text">
                    <br>
                    <label for=name>ZIP / Postal code: </label><br>
                    <input required autocomplete="off" name="zip" type="text">
                    
                    <div class="two-button">
                    <button id="ship-pii-submit">Submit</button>
                    <button type="button" onclick="document.getElementById('ship-pii-container').style.display='none';">Cancel</button>
                    </div>
                <% end %>
            </div>
        </div>
    </div>
    
    <div id="shipped-voyage" <% if @voyage == nil or @voyage.ship_status == 0 %> style="display:none;"<% end %>>
        <h1>Voyage Shipped!</h1>
        <% if @voyage != nil && @voyage.ship_status == 2 %>
        <h2>Project has been approved.</h2>
        <p style="width:600px;max-width:100%;display:block;margin: 0 auto;">
    Prize-fulfillment has not yet started, but you will receive a slack DM about fulfillment sometime before the end of the event.
        <br>
        You can start working on another project if you like.
        </p>
        <br>
        <div class="surround-border"><button class="voyage-btn small-voyage-btn" onclick="newVoyageAfterShip();" id="new-voyage-after-ship">New Voyage</button></div>
        <% else %>
        <h2>Awaiting approval.</h2>
        <p style="width:600px;max-width:100%;display:block;margin: 0 auto;">If you intend to ship another project,
        you can start working on it and tracking hackatime hours already.<br>
        You just can't link it to Out to C until this project is approved.
        </p>
        <% end %>
    </div>

    <div id="shipped-or-active-voyage" <% if @voyage == nil %> style="display:none;"<% end %>>
        <% if Rails.env.development? %>
        <div class="page" id="devpanel">
            <h2>Dev panel</h2>
            <%= form_with(url: voyage_add_hour_path) do |form| %>
                <button onclick="setTravelDistance(travelDistance+1)">add 1 Hour</button>
            <% end %>
            <%= form_with(url: voyage_delete_force_path) do |form| %>
                <button>force delete voyage</button>
            <% end %>
        </div>
        <% end %>
        <% if @user.token == nil %>
        <div class="page" id="hackatime-panel">
            <a href="https://hackatime.hackclub.com/oauth/authorize?client_id=<%= ENV["HACKATIME_UID"] %>&redirect_uri=<%= CGI.escape(auth_hackatime_callback_url) %>&response_type=code&scope=read+profile" id="link-hackatime">Link Hackatime</a>
        </div>
        <% end %>
        <div id="cargo">
            <div id="cargo-header">
                <span>Ship Cargo</span>
                <button onclick="toggleCargo()">🞫</button>
            </div>
            <div id="cargo-body">
                <div id="cargo-slots">
                    <%=
                    pcs = []
                    cargo = @user.all_prizes
                    if cargo == nil
                        cargo = ""
                    end
                    if @voyage != nil && @voyage.ship_status != 2
                        cargo += @voyage.cargo
                    end
                    for pc in cargo.split(",",-1)
                        # find item details from @prices
                        for a in @prices
                            g = a[pc.to_sym]
                            if g != nil
                                pcs.append([pc,g[:name]])
                            end
                        end
                    end
                    ActiveSupport::SafeBuffer.new("<script>pcs="+pcs.to_json+"</script>")
                    %>
                    <% (0..4*3-1).each do |x| %>
                        <div class="cargo-slot" id="cargoSlot<%= x %>">
                            <%= if pcs[x] != nil && pcs[x] != ""
                            puts (image_tag "prices/"+ pcs[x][0] + ".png").class
                            image_tag "prices/"+ pcs[x][0] + ".png"
                            else
                            ActiveSupport::SafeBuffer.new("<img>")
                            end %>
                        </div>
                    <% end %>
                </div>
                <div id="cargo-info">
                    <div id="cargo-info-contents" style="display:none">
                        <img id="cargo-info-img" src="">
                        <hr>
                        <span id="cargo-info-text">Blahaj</span>
                    </div>
                </div>
            </div>
        </div>
        <button onclick="toggleCargo()" id="cargo-button"><%= image_tag "graphics/cargo.png", :alt => "Cargo" %></button>
    </div>
</div>

<script src="<%= asset_path "onboarding.js" %>"></script>