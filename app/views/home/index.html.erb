<script>
    // load user data for the JS side
    voyage = parseInt('<%= @voyage && @voyage.id %>') || null;
    _travelDistance = (parseFloat('<%= @voyage && @voyage.total_seconds %>') / 60.0 / 60.0 || 0.0);

    _activeCameraStateIndex = voyage == null ? 0 : 2;

    prices = "<%= @voyage && @voyage.cargo %>";

    shipStatus = <%= @voyage != nil ? @voyage.ship_status : 0%>
</script>

<style>
    canvas {
        filter: unset !important;
    }
</style>

<div id="background"></div>
<div id="varyingContents">
    <div id="confirmation-container" style="display:none">
        <div id="confirmation-box">
            <p id="confirmation-text" style="margin:0">Are you sure you wish to perform this action?</p>
            <div style="display:flex">
                <button onclick="confirmConfirmation()" class="confirm-btn">Yes, go ahead!</button>
                <button onclick="cancelConfirmation()" class="confirm-btn" style="margin-left:5px">No.</button>
            </div>
        </div>
    </div>
    <%= form_with(url: voyage_delete_path, id: "delete-voyage-form") do |form| end %>

    <button onclick="backVoyage();" id="new-voyage-back"><%= image_tag "graphics/back.png", :alt => "Back" %></button>
    <div id="new-voyage-div" class="page surround-border">
        <% new_or_edit = @voyage == nil ? "New" : "Edit" %>
        <% create_or_save = @voyage == nil ? "CREATE VOYAGE" : "SAVE CHANGES" %>
        <h1 id="new-voyage-title"><%= new_or_edit %> Voyage</h1>
        <%= form_with(url: voyage_new_path, id: "new-voyage-form") do |form| %>
            <label for=name>Name: </label><br>
            <input autocomplete="off" name="name" type="text" value="<%= @voyage != nil && @voyage.name != nil ? @voyage.name : "" %>">
            <br>
            <label for=desc>Description (optional): </label><br>
            <input autocomplete="off" name="desc" type="text"  value="<%= @voyage != nil && @voyage.desc != nil ? @voyage.desc : "" %>">
            <br>
            <label for=repo>Github Repository URL (optional): </label><br>
            <input autocomplete="off" name="repo" type="url"  value="<%= @voyage != nil && @voyage.repo != nil ? @voyage.repo : "" %>">

            <br>
            <label for=hackatime>Select Hackatime project (optional): </label><br>

            <select autocomplete="off" name="hackatime" id="hackatime">
                <option value="" <%= @voyage == nil ? "selected" : "" %>>Select a Hackatime project</option>
                <% @projects.each do |x| %>
                    <% sel = @voyage != nil && @voyage.hackatime == x["name"] ? "selected" : "" %>
                    <option <%= sel %> value="<%= x["name"] %>"><%= x["name"] + " (" + (x["total_seconds"].to_f / 60.0 / 60.0).to_i.to_s + " hrs)" %></option>
                <% end %>
            </select>
            <br>
            <button id="new-voyage-form-submit"><%= create_or_save %></button>
            <button id="delete-voyage-button" style="display:<%= @voyage == nil ? "none" : "block" %>" type="button" onclick="tryDeleteVoyage();">Delete Voyage...</button>
        <% end %>
    </div>

    <img id="pfp" src="<%= session[:user_id]["pfp"] %>">
    <div id="cargo-slot-dragging-container"><img id="cargo-slot-dragging"></div>
    <div id="no-existing-voyage" <% if @voyage != nil %> style="display:none;"<% end %>>
        <img id="logo" style="width:450px;" src="<%= asset_path("graphics/logo.svg") %>" alt="Out To C">
        <div id="new-voyage-buttons">
            <div class="surround-border"><a <%= @user.token != nil ? "disabled" : "" %> class="voyage-btn" href="https://hackatime.hackclub.com/oauth/authorize?client_id=<%= ENV["HACKATIME_UID"] %>&redirect_uri=<%= CGI.escape(auth_hackatime_callback_url) %>&response_type=code&scope=profile+read" id="link-hackatime">Link Hackatime</a></div>
            <div class="surround-border"><button <%= @user.token == nil ? "disabled" : "" %> class="voyage-btn" onclick="newVoyage();" id="new-voyage">New Voyage</button></div>
        </div>
    </div>
    <div id="active-voyage" <% if @voyage == nil %> style="display:none;"<% end %>>
        <% if Rails.env.development? %>
        <div class="page" id="devpanel">
            <h2>Dev panel</h2>
            <%= form_with(url: voyage_add_hour_path) do |form| %>
                <button onclick="setTravelDistance(travelDistance+1)">add 1 Hour</button>
            <% end %>
        </div>
        <% end %>
        <div id="ship-container">
            <button onclick="tryShipVoyage()" id="ship-button">Ship Project</button>
            <%= form_with(url: voyage_ship_path, id: "ship-form") do |form| end %>
        </div>
        <div id="voyage-info">
            <div id="voyage-info-contents">
                <span class="light">Voyage name:</span>
                <span id="voyage-info-name"><%= @voyage_name_trim %></span><br>
                <span class="light">Desc:</span>
                <span id="voyage-info-desc"><%= @voyage_desc_trim %></span><br>
                <span class="light">Repository URL:</span>
                <a id="voyage-info-repo" style="white-space: nowrap;" href="<%= @voyage != nil && @voyage.repo != nil ? @voyage.repo : "" %>"><%= @voyage_repo_trim %></a><br>
                <span class="light">Hackatime:</span><br>
                <span id="voyage-info-hackatime"> <%= @hackatime_text %> </span><br>
                <button id="edit-voyage" onclick="editVoyage()">Edit Details</button>
            </div>
        </div>
        <div id="cargo">
            <div id="cargo-header">
                <span>Ship Cargo</span>
                <button onclick="toggleCargo()">🞫</button>
            </div>
            <div id="cargo-body">
                <div id="cargo-slots">
                    <%=
                    pcs = []
                    if @voyage != nil
                        for pc in @voyage.cargo.split(",",-1)
                            # find item details from @prices
                            for a in @prices
                                g = a[pc.to_sym]
                                if g != nil
                                    pcs.append([pc,g[:name]])
                                end
                            end
                        end
                    end
                    ActiveSupport::SafeBuffer.new("<script>pcs="+pcs.to_json+"</script>")
                    %>
                    <% (0..4*3-1).each do |x| %>
                        <div class="cargo-slot" id="cargoSlot<%= x %>">
                            <%= if pcs[x] != nil && pcs[x] != ""
                            puts (image_tag "prices/"+ pcs[x][0] + ".png").class
                            image_tag "prices/"+ pcs[x][0] + ".png"
                            else
                            ActiveSupport::SafeBuffer.new("<img>")
                            end %>
                        </div>
                    <% end %>
                </div>
                <div id="cargo-info">
                    <div id="cargo-info-contents" style="display:none">
                        <img id="cargo-info-img" src="">
                        <hr>
                        <span id="cargo-info-text">Blahaj</span>
                    </div>
                </div>
            </div>
        </div>
        <button onclick="toggleCargo()" id="cargo-button"><%= image_tag "graphics/cargo.png", :alt => "Cargo" %></button>
        <div id="minimap" <%= @found_island ? "style=display:none" : "" %>>
            <%= image_tag "graphics/ship_icon.png",:id => "ship-icon" , :alt => "ship-icon" %>
            <%= image_tag "graphics/treasure_icon.png",:id => "treasure-icon" , :alt => "treasure-icon" %>
            <span id="minimap-text"><%= @voyage != nil ? (@next_island - @voyage.total_seconds / 60 / 60 + 0.5).to_i.to_s : "-" %> hours </span>
        </div>
        <div id="island-found" style="<%= @found_island ? "display:unset; animation-play-state: running;" : "" %>">
            <div id="island-found-center">
                <link rel="preload" as="image" href="<%= image_url("graphics/treasure_chest_open.png")  %>" fetchpriority="high">
                <%= image_tag "graphics/island_found.png",:id => "island-found-image" , :alt => "Island" %>
                <button onclick="selectTreasure()" id="island-found-chest"></button>
            </div>
            <div id="treasure-select-container">
                <div id="treasure-select">
                    <h1>Treasure Chest</h1>
                    <span>Select 1 item to receive.</span>
                    <br>
                    
                    <%= 
                    fp = JSON.parse(@found_prices.to_json)
                    fp.each_with_index do | x, i |
                        x[1]["src"] = image_url("prices/"+x[0].to_s+".png")
                    end

                    ActiveSupport::SafeBuffer.new("<script>found_prices="+fp.to_json+"</script>")
                    %>
                    <div id="prices-buttons">
                    </div>
                    <button id="price-submit-btn" onclick="finalizePriceSelection();" class="confirm-btn">Confirm</button>
                    <%= form_with(url: voyage_price_path, id: "price-form") do |form| end %>
                    </div>
                </div>
        </div>
    </div>
</div>
