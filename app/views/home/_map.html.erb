<div id="map-holder">
    <% for mi in 0..4-1 %>
    <div class="map-marker" id="map-marker-<%= mi+1 %>">
        <div class="spread spread<%= @prices[mi].length %>">
            <% for i in @prices[mi] %>
            <img src="<%= asset_path("prices/#{i[0]}.png") %>" title="<%= i[1][:name] %>">
            <% end %>
        </div>
    </div>
    <% end %>
    <div class="map-marker" id="map-marker-5">
        <div>
            <div>
                <p>Merchant Ship</p>
            </div>
        </div>
    </div>
    <% if @loggedin %>
    <div id="ship-map-marker">
        <%= image_tag "graphics/ship_icon.png" %>
        <p>You are here</p>
    </div>
    <% end %>
    <object id="map" data="<%= asset_path "graphics/map.svg" %>"></object>
</div>