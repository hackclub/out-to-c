<% content_for :title, "Reviewer Panel | Out to C" %>

<h1>Reviewer Panel</h1>

<hr>
<a href="/reviewer">Go back</a>
<div class="admin-edit">
    <h1 style="margin-top:0;"><%= @voyage.name %></h1>
    
    <p><%= @voyage.desc %></p>

    <pre>Hackatime: <%= @voyage.hackatime + " (" + (@voyage.total_seconds / 60 / 60).to_i.to_s + " hours)" %></pre>

    <div style="width:100%;height: 55px;">
        <label for="cargo-input">Cargo: </label>
        <div class="reviewer-price">
        <% for p in @voyage.cargo.split(",") %>
        <%= image_tag "prices/"+p+".png" %>
        <% end %>
        </div>
    </div>
    
    <a target="_blank" class="reviewer-link-btn" href="<%= @voyage.demo %>">Demo</a>
    <a target="_blank" class="reviewer-link-btn" href="<%= @voyage.repo %>">Repository</a><br>
    <br>
    <span><img style="width:40px;aspect-ratio:1;border-radius:25px;" src="<%= @owner.pfp %>"> made by @<%= @owner.name %></span><br><br>

    <img style="width:100%;max-height:600px;max-width: 900px;image-rendering:unset !important;" src="<%= @voyage.image_link %>">
</div>

<% if @owner.past_voyages != nil && not(@owner.past_voyages.blank?) && not(@owner.past_voyages.start_with?(@voyage.id.to_s + ",")) %>
<div class="admin-edit">
    <p>Approved Past Voyages:</p>
    <%
    for vi in @owner.past_voyages.split(",")
    if vi.to_i == @voyage.id
        break
    end
    %>

    <div class="admin-voyage-entry">
        <% v = Voyage.find(vi) %>
        <a target="_blank" style="float:right" href="/reviewer/edit/<%= v.id %>">view</a>
        <p><b><%= trim_length_fixed(v.name,55) %></b></p>
        <pre><%= v.hackatime + " (" + (v.total_seconds / 60 / 60).to_i.to_s + "h)"%></pre>
    </div>
    <% end %>
</div>
<% end %>

<div class="admin-edit">
    <%= form_with(url: reviewer_submit_edit_path, id: "submit") do |form| %>
    <input type="hidden" name="id" value="<%= @voyage.id %>">
    <input type="hidden" name="updated" value="<%= @voyage.updated_at %>">
    <label for="note">Reviewer Note: </label>
    <textarea autocomplete="off" class="reviewer-textarea" type="text" id="note" name="reviewer_note" value=""><%= @voyage.reviewer_note %></textarea><br>
    
    
    <% if @voyage.ship_status == 1 %>
        <p class="light">When you Reject/Approve a project, the user receives a slack DM from @Pirate Orph' containing the reviewer note.</p>
    <% else %>
        <p class="light">When you re-review a project, <u>no slack DMs</u> are sent. </p>
    <% end %>
    <br>

    <hr>
    <p>The following fields <u>are only required for approvals:</u></p>

    <label for="justification">Specific Technical Features: </label>
    <textarea autocomplete="off" class="reviewer-textarea" type="text" id="justification" name="justification" value=""><%= @voyage.justification %></textarea><br>
    <p style="margin-bottom: 5px;" class="light">Here you should list specific technical details about the project that justify the time spent.<br>
    A good example for a game:<br>
    </p>
    <pre class="light">"open world, saving, co-op multiplayer"</pre>
    <br>
    <label for="additional_justification">Additional Justification (optional): </label>
    <textarea autocomplete="off" class="reviewer-textarea" type="text" id="additional_justification" name="additional_justification" value=""><%= @voyage.additional_justification %></textarea><br>
    <p style="margin-bottom: 5px;" class="light">Optional more information to justify the project's approval. <br>
    <br>

    <div style="display:flex; width: 100%">
        <% if @voyage.ship_status == 1 %>
        <button onclick="reviewerSubmit(false)" class="reviwer-button" style="border-color:red;">Reject</button>
        <% end %>
        <button onclick="reviewerSubmit(true)" class="reviwer-button" style="border-color:#5376ff;">
            <% if @voyage.ship_status == 1 %>
            Approve
            <% else %>
            Save Approved Ship
            <% end %>
        </button>
    </div>
    <% end %>
</div>
<br>
<script src="<%= asset_path "reviewer.js" %>"></script>